# Copy to .env and fill in. Never commit real values. Full reference: docs/ENVIRONMENT.md

# --- Core -------------------------------------------------------------------
# Public base URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | preview | production (defaults to VERCEL_ENV). Non-production sites are noindex.
SITE_ENV=development
# PostgreSQL connection string (use the pooled connection string on Neon/Supabase)
DATABASE_URI=postgres://rcq:rcq@localhost:5432/rcq
# 32+ random characters: openssl rand -hex 32
PAYLOAD_SECRET=
# Secret salt for hashing IP addresses (never stored raw): openssl rand -hex 32
IP_HASH_SALT=
# Bearer secret for /api/cron/* routes: openssl rand -hex 32
CRON_SECRET=

# --- Search -----------------------------------------------------------------
# postgres (default). Future: meilisearch | algolia
SEARCH_PROVIDER=postgres

# --- File storage -----------------------------------------------------------
# local (dev/test only, refused on Vercel production) | s3 (Cloudflare R2 or any S3 API)
STORAGE_DRIVER=local
# S3 / R2 settings (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket for CMS media and published documents (served through the app with access control)
S3_PUBLIC_BUCKET=
# Private bucket for RFQ attachments (never public)
S3_PRIVATE_BUCKET=

# --- RFQ --------------------------------------------------------------------
# Default sales inbox(es), comma separated. Overridden by Site Settings in the admin when set.
RFQ_NOTIFY_TO=sales@example.com
# Sender used for transactional email (domain must be verified in Resend)
EMAIL_FROM=rfq@example.com
EMAIL_FROM_NAME=RC Quartermaster
RESEND_API_KEY=
# Attachment limits
RFQ_MAX_FILES=5
RFQ_MAX_FILE_MB=10
RFQ_MAX_TOTAL_MB=25
# Rate limits (per hashed IP)
RFQ_RATE_LIMIT_PER_HOUR=5
RFQ_RATE_LIMIT_PER_DAY=20
RFQ_RATE_LIMIT_PER_EMAIL_PER_DAY=10
UPLOAD_RATE_LIMIT_PER_HOUR=30
# none (marks attachments "skipped") | custom providers added in src/lib/security/scanner.ts
SCANNER_PROVIDER=none
# true = attachments with scan status "skipped" may be downloaded by staff
ALLOW_UNSCANNED_DOWNLOADS=true

# --- Turnstile --------------------------------------------------------------
# Cloudflare test keys (always pass). Replace with real keys per environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Analytics (optional) ---------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# --- Build helpers ----------------------------------------------------------
# true = data layer returns empty data during `next build` (CI without a database)
SKIP_BUILD_DB=false

# --- Local development ------------------------------------------------------
# true = let Payload push schema changes to the local database automatically. Never set in preview/production.
DB_PUSH=false
